<odoo>


    <record id="view_receipt_report_wizard" model="ir.ui.view">
        <field name="name">receipt.report.wizard.form</field>
        <field name="model">trade.management.receipt.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Receipt Report">

                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>

                <footer>
                    <button name="action_print_report"
                            type="object"
                            string="Print"
                            class="btn-primary"/>

                    <button string="Cancel" special="cancel"/>
                </footer>

            </form>
        </field>
    </record>


    <record id="action_receipt_report_wizard" model="ir.actions.act_window">
        <field name="name">Receipt Report Wizard</field>
        <field name="res_model">trade.management.receipt.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>