<odoo>

    <record id="view_trade_management_sales_list" model="ir.ui.view">
        <field name="name">trade.management.sales.list</field>
        <field name="model">trade.management.sales</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="number"/>
            </list>
        </field>
    </record>

    <record id="view_trade_management_sales_form" model="ir.ui.view">

        <field name="name">trade.management.sales.form</field>
        <field name="model">trade.management.sales</field>
        <field name="arch" type="xml">
            <form>


                 <header>

                    <button name="action_post"
                            type="object"
                            string="Post"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>


                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="number"/>
                    </group>

                    <notebook>

                        <page string="Products">

                            <field name="line_ids">

                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="price" force_save="1" readonly="1"/>
                                    <field name="sum"/>
                                    <field name="quantity"/>
                                    <field name="currency_id"/>
                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trade_management_sales" model="ir.actions.act_window">
        <field name="name">Sales registration</field>
        <field name="res_model">trade.management.sales</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>