<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_product_category_wizard_form" model="ir.ui.view">
        <field name="name">product.category.wizard.form</field>
        <field name="model">product.category.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Category">

                <group>
                    <field name="categ_id"/>
                    <field name="product_ids" widget="many2many_tags"/>
                </group>

                <footer>
                    <button string="Change Category"
                            type="object"
                            name="action_apply"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"/>
                </footer>

            </form>
        </field>
    </record>

    <record id="action_product_category_wizard" model="ir.actions.act_window">
        <field name="name">Change Category</field>
        <field name="res_model">product.category.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>