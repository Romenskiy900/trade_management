<odoo>

    <template id="receipt_report_template">

        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <div class="page">

                    <h2>Receipt Report</h2>

                    <table class="table table-sm table-bordered">

                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Partner</th>
                                <th>Product</th>
                                <th>Quantity</th>
                            </tr>
                        </thead>

                        <tbody>

                            <t t-foreach="docs" t-as="receipt">

                                <t t-foreach="receipt.line_ids" t-as="line">

                                    <tr>

                                        <td>
                                            <span t-field="receipt.date"/>
                                        </td>

                                        <td>
                                            <span t-field="receipt.pertner_id"/>
                                        </td>

                                        <td>
                                            <span t-field="line.product_id"/>
                                        </td>

                                        <td>
                                            <span t-field="line.quantity"/>
                                        </td>

                                    </tr>

                                </t>

                            </t>

                        </tbody>

                    </table>

                </div>

            </t>
        </t>

    </template>

</odoo>