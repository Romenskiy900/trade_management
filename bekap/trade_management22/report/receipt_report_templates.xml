<odoo>
    <template id="receipt_report_template">

        <t t-call="web.external_layout">

            <main>
                <div class="page">

                    <h2>Receipt Report</h2>

                    <p>
                        <strong>Date From:</strong>
                        <t t-esc="date_from"/>
                        |
                        <strong>Date To:</strong>
                        <t t-esc="date_to"/>
                    </p>

                    <t t-foreach="grouped.items()" t-as="date_group">

                        <h3>
                            Date: <t t-esc="date_group[0]"/>
                        </h3>

                        <t t-foreach="date_group[1].items()" t-as="partner_group">

                            <h4>
                                Partner: <t t-esc="partner_group[0]"/>
                            </h4>

                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Quantity</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <t t-foreach="partner_group[1].items()" t-as="product_group">
                                        <tr>
                                            <td>
                                                <t t-esc="product_group[0]"/>
                                            </td>
                                            <td>
                                                <t t-esc="product_group[1]"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>

                            </table>

                        </t>

                    </t>

                </div>
            </main>

        </t>

    </template>
</odoo>