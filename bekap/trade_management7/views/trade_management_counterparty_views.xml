<odoo>

    <record id="view_trade_management_counterparty_list" model="ir.ui.view">
        <field name="name">trade.management.counterparty.list</field>
        <field name="model">trade.management.counterparty</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_trade_management_counterparty_form" model="ir.ui.view">
        <field name="name">trade.management.counterparty.form</field>
        <field name="model">trade.management.counterparty</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>



    <record id="action_trade_management_counterparty" model="ir.actions.act_window">
        <field name="name">Контрагенти</field>
        <field name="res_model">trade.management.counterparty</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>