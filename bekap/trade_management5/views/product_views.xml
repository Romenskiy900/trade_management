<odoo>

    <record id="view_product_form_inherit_trade" model="ir.ui.view">
        <field name="name">product.template.form.trade</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!-- Вставляем в основную страницу "General Information" -->
            <xpath expr="//page[@name='general_information']//group" position="inside">
                <group string="Trade Fields">
                    <field name="is_trade_item"/>
                </group>
            </xpath>

        </field>
    </record>

    <record id="action_trade_products" model="ir.actions.act_window">
        <field name="name">Товары (Trade)</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_trade_item', '=', True)]</field>
    </record>

</odoo>