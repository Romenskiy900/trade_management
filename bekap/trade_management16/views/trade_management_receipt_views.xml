<odoo>

    <record id="view_trade_management_receipt_list" model="ir.ui.view">
        <field name="name">trade.management.receipt.list</field>
        <field name="model">trade.management.receipt</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="number"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

     <record id="view_trade_management_receipt_form" model="ir.ui.view">

        <field name="name">trade.management.receipt.form</field>
        <field name="model">trade.management.receipt</field>
        <field name="arch" type="xml">

            <form>

                <header>

                      <!-- КНОПКА ПРОВЕДЕНИЯ -->
                    <button name="action_post"
                            type="object"
                            string="Post"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,posted"/>
                </header>

                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="number"/>
                        <field name="partner_id"/>
                        <field name="date"/>
                    </group>

                    <notebook>

                        <page string="Product">

                            <field name="line_ids">

                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>

    <record id="view_trade_management_receipt_search" model="ir.ui.view">
        <field name="name">trade.management.receipt.search</field>
        <field name="model">trade.management.receipt</field>
        <field name="arch" type="xml">
            <search>

                <field name="partner_id"/>

                <filter string="По контрагенту"
                        name="name_filter"
                        domain="[]"
                        context="{}"/>

            </search>
        </field>
    </record>


    <record id="action_trade_management_receipt" model="ir.actions.act_window">
        <field name="name">Arrival of goods</field>
        <field name="res_model">trade.management.receipt</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>