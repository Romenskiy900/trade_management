<odoo>

    <record id="view_visit_report_wizard_form" model="ir.ui.view">
        <field name="name">visit.report.wizard.form</field>
        <field name="model">visit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Звіт по візитах">
                <group>
                    <field name="doctor_ids"/>
                    <field name="patient_ids"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="only_done"/>
                    <field name="disease_id"/>
                </group>

                <footer>
                    <button name="action_generate"
                            type="object"
                            string="Згенерувати"
                            class="btn-primary"/>

                    <button string="Скасувати"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>