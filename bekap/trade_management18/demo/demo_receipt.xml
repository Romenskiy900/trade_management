<odoo>
    <data noupdate="1">

        <record id="receipt_1"
                model="trade.management.receipt">

            <field name="partner_id"
                   ref="partner_global_trade"/>

            <field name="date">2026-01-10 10:00:00</field>

        </record>

        <record id="receipt_1_line_1"
                model="trade.management.receipt.line">

            <field name="receipt_id"
                   ref="receipt_1"/>

            <field name="product_id" ref="prod_milk"/>
            <field name="quantity">100</field>

        </record>

        <record id="receipt_1_line_2"
                model="trade.management.receipt.line">

            <field name="receipt_id"
                   ref="receipt_1"/>

            <field name="product_id" ref="prod_bread"/>
            <field name="quantity">50</field>

        </record>

    </data>
</odoo>