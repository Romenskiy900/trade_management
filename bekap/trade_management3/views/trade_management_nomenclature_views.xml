<odoo>

    <record id="view_trade_management_nomenclature_list" model="ir.ui.view">
        <field name="name">trade.management.nomenclature.list</field>
        <field name="model">trade.management.nomenclature</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type_id"/>
            </list>
        </field>
    </record>

    <record id="view_trade_management_nomenclature_form" model="ir.ui.view">
        <field name="name">trade.management.nomenclature.form</field>
        <field name="model">trade.management.nomenclature</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_trade_management_nomenclature_kanban" model="ir.ui.view">
        <field name="name">trade.management.nomenclature.kanban</field>
        <field name="model">trade.management.nomenclature</field>
        <field name="arch" type="xml">
            <kanban default_group_by="type_id"
                    group_create="true"
                    groups_draggable="true">

                <field name="name"/>
                <field name="type_id"/>

                <templates>

                    <t t-name="card">

                        <div class="oe_kanban_card oe_kanban_global_click">

                            <div class="oe_kanban_details">

                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>

                                <div class="mt8">
                                    <span>
                                        Вид:
                                        <field name="type_id"/>
                                    </span>
                                </div>

                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>
        </field>
    </record>


    <record id="view_trade_management_nomenclature_search" model="ir.ui.view">
        <field name="name">trade.management.nomenclature.search</field>
        <field name="model">trade.management.nomenclature</field>
        <field name="arch" type="xml">
            <search>

                <field name="type_id"/>

                <filter string="По виду номенклатури"
                        name="name_filter"
                        domain="[]"
                        context="{}"/>

            </search>
        </field>
    </record>

    <record id="action_trade_management_nomenclature" model="ir.actions.act_window">
        <field name="name">Номенклатура</field>
        <field name="res_model">trade.management.nomenclature</field>
        <field name="view_mode">list,form,search,kanban</field>
        <field name="search_view_id" ref="view_trade_management_nomenclature_search"/>
    </record>

</odoo>