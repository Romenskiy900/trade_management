<odoo>
    <record id="view_sales_line_pivot" model="ir.ui.view">
        <field name="name">trade.management.sales.line.pivot</field>
        <field name="model">trade.management.sales.line</field>
        <field name="arch" type="xml">
            <pivot string="Продаж">

                <field name="nomenclature_id" type="row"/>

                <field name="quantity" type="measure"/>
                <field name="price" type="measure"/>

            </pivot>
        </field>
    </record>

    <record id="action_sales_pivot" model="ir.actions.act_window">
        <field name="name">Продаж</field>
        <field name="res_model">trade.management.sales.line</field>
        <field name="view_mode">pivot</field>
    </record>

</odoo>