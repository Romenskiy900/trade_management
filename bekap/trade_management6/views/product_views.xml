<odoo>
    <data>

        <!-- FORM VIEW: только name -->
        <record id="view_product_form_only_name" model="ir.ui.view">
            <field name="name">product.template.form.only.name</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">

                <xpath expr="//sheet" position="replace">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sale_type"/>
                        </group>
                    </sheet>

                </xpath>

            </field>
        </record>


        <!-- ACTION -->
        <record id="action_trade_products" model="ir.actions.act_window">
            <field name="name">Товары (Trade)</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>