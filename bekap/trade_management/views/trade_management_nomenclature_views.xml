<odoo>

    <record id="view_trade_management_nomenclature_list" model="ir.ui.view">
        <field name="name">trade.management.nomenclature.list</field>
        <field name="model">trade.management.nomenclature</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="type"/>
            </list>
        </field>
    </record>

    <record id="view_trade_management_nomenclature_form" model="ir.ui.view">
        <field name="name">trade.management.nomenclature.form</field>
        <field name="model">trade.management.nomenclature</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_trade_management_nomenclature_search" model="ir.ui.view">
        <field name="name">trade.management.nomenclature.search</field>
        <field name="model">trade.management.nomenclature</field>
        <field name="arch" type="xml">
            <search>

                <field name="type"/>

                <filter string="По виду номенклатури"
                        name="name_filter"
                        domain="[]"
                        context="{}"/>

            </search>
        </field>
    </record>

    <record id="action_trade_management_nomenclature" model="ir.actions.act_window">
        <field name="name">Номенклатура</field>
        <field name="res_model">trade.management.nomenclature</field>
        <field name="view_mode">list,form,search</field>
        <field name="search_view_id" ref="view_trade_management_nomenclature_search"/>
    </record>

</odoo>