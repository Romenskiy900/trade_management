<odoo>

    <!-- GRAPH -->
    <record id="view_trade_management_price_set_line_graph" model="ir.ui.view">

        <field name="name">trade.management.price.set.line.graph</field>
        <field name="model">trade.management.price.set.line</field>

        <field name="arch" type="xml">

            <graph string="Product price schedule" type="bar">

                <field name="product_id"/>
                <field name="price" type="measure"/>

            </graph>

        </field>

    </record>


    <!-- ACTION GRAPH -->
    <record id="action_trade_management_price_set_line_graph" model="ir.actions.act_window">

        <field name="name">Product price schedule</field>
        <field name="res_model">trade.management.price.set.line</field>
        <field name="view_mode">graph</field>

    </record>

</odoo>