<odoo>

    <record id="receipt_user_rule" model="ir.rule">
        <field name="name">Receipt: only own documents</field>
        <field name="model_id" ref="model_trade_management_receipt"/>

        <!-- user can see only receipts created by themselves -->
        <field name="domain_force">[('create_uid', '=', user.id)]</field>

        <!-- rule applied only for manager group -->
        <field name="groups" eval="[(4, ref('trade_management.group_meneger'))]"/>

        <field name="perm_read" eval="1"/>
    </record>

    <record id="receipt_admin_rule" model="ir.rule">
        <field name="name">Receipt: admin sees everything</field>
        <field name="model_id" ref="model_trade_management_receipt"/>

        <!-- always true domain, no restrictions -->
        <field name="domain_force">[(1, '=', 1)]</field>

        <!-- rule applied only for admin group -->
        <field name="groups" eval="[(4, ref('trade_management.group_trade_admin'))]"/>

        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>