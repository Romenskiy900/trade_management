<odoo>
    <data>

        <!-- LIST VIEW -->
        <record id="view_hr_hospital_doctor_list" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.list</field>
            <field name="model">hr.hospital.doctor</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="user_id"/>
                    <field name="mentor_id"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW (ВСЕ ТРЕБОВАНИЯ 3.1) -->
        <record id="view_hr_hospital_doctor_form" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.form</field>
            <field name="model">hr.hospital.doctor</field>
            <field name="arch" type="xml">
                <form string="Лікар">
                    <sheet>

                        <!-- ВСЕ ПОЛЯ -->
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="user_id"/>
                            <field name="is_intern"/>
                            <field name="mentor_id"/>
                        </group>

                        <!-- МЕНТОР -->
                        <group string="Ментор" invisible="not mentor_id">
                            <field name="mentor_id" readonly="1"/>
                        </group>

                        <!-- ИНТЕРНЫ -->
                        <group string="Інтерни" invisible="not intern_ids">
                            <field name="intern_ids" mode="kanban">
                                <kanban>
                                    <field name="name"/>
                                    <field name="category_id"/>

                                    <templates>
                                        <t t-name="card">
                                            <div class="o_kanban_record">
                                                <strong>
                                                    <field name="name"/>
                                                </strong>
                                                <div>
                                                    <field name="category_id"/>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>

                                </kanban>
                            </field>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <!-- KANBAN VIEW (3.3 + QUICK VISIT) -->
        <record id="view_hr_hospital_doctor_kanban" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.kanban</field>
            <field name="model">hr.hospital.doctor</field>
            <field name="arch" type="xml">
                <kanban default_group_by="category_id" quick_create="true">

                    <field name="name"/>
                    <field name="category_id"/>

                    <templates>
                        <t t-name="card">
                            <div class="o_kanban_record">

                                <strong>
                                    <field name="name"/>
                                </strong>

                                <div>
                                    <field name="category_id"/>
                                </div>

                                <!-- QUICK VISIT -->
                                <div style="margin-top:10px;">
                                    <button type="object"
                                            name="action_create_visit"
                                            class="btn btn-primary btn-sm">
                                        Запис на візит
                                    </button>
                                </div>

                            </div>
                        </t>
                    </templates>

                </kanban>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_hr_hospital_doctor" model="ir.actions.act_window">
            <field name="name">Лікарі</field>
            <field name="res_model">hr.hospital.doctor</field>
            <field name="view_mode">list,kanban,form</field>
        </record>

    </data>
</odoo>