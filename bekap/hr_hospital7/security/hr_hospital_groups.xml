<odoo>

    <record id="group_patient" model="res.groups">
        <field name="name">Пацієнт</field>
    </record>

    <record id="group_intern" model="res.groups">
        <field name="name">Інтерн</field>
        <field name="implied_ids" eval="[(4, ref('your_module.group_patient'))]"/>
    </record>

    <record id="group_doctor" model="res.groups">
        <field name="name">Лікар</field>
        <field name="implied_ids" eval="[(4, ref('your_module.group_intern'))]"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Менеджер</field>
        <field name="implied_ids" eval="[(4, ref('your_module.group_doctor'))]"/>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Адміністратор</field>
        <field name="implied_ids" eval="[(4, ref('your_module.group_manager'))]"/>
    </record>

</odoo>