<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_doctor_document">

        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">

                <t t-call="web.external_layout">

                    <div class="page">

                        <!-- HEADER -->
                        <div class="row mb-4">

                            <div class="col-3">
                                <img t-if="doc.env.company.logo"
                                     t-att-src="image_data_uri(doc.env.company.logo)"
                                     style="max-height:120px;"/>
                            </div>

                            <div class="col-9 text-end">

                                <h2>
                                    <t t-esc="doc.env.company.name"/>
                                </h2>

                                <div>
                                    <strong>Телефон:</strong>
                                    <span t-esc="doc.env.company.phone"/>
                                </div>

                                <div>
                                    <strong>Email:</strong>
                                    <span t-esc="doc.env.company.email"/>
                                </div>

                            </div>

                        </div>

                        <!-- DOCTOR TITLE -->
                        <h2 class="text-center">
                            <t t-esc="doc.name"/>
                        </h2>

                        <h4 class="text-center text-muted">
                            <t t-esc="doc.category_id.name or '—'"/>
                        </h4>


                        <!-- 1.3 VISITS -->
                        <h3>Історія візитів</h3>

                        <table class="table table-sm table-bordered">

                            <thead>
                                <tr>
                                    <th>Пацієнт</th>
                                    <th>Дата</th>
                                    <th>Статус</th>
                                    <th>Діагноз</th>
                                </tr>
                            </thead>

                            <tbody>

                                <!-- последние сверху -->
                                <t t-foreach="doc.visit_ids" t-as="v">

                                    <tr>
                                        <td><t t-esc="v.patient_id.name"/></td>
                                        <td><t t-esc="v.visit_datetime or v.planned_datetime"/></td>
                                        <td><t t-esc="v.status"/></td>
                                        <td><t t-esc="v.disease_id.name"/></td>
                                    </tr>

                                </t>

                            </tbody>

                        </table>


                        <!-- 1.4 PATIENTS -->
                        <h3>Пацієнти лікаря</h3>

                        <table class="table table-bordered">

                            <thead>
                                <tr>
                                    <th>ПІБ</th>
                                    <th>Стать</th>
                                    <th>Дата народження</th>
                                    <th>Телефон</th>
                                    <th>Статус</th>
                                </tr>
                            </thead>

                            <tbody>

                                <t t-foreach="doc.patient_ids" t-as="p">

                                    <t t-set="v" t-value="doc.visit_ids.filtered(lambda x: x.patient_id.id == p.id)[:1] and doc.visit_ids.filtered(lambda x: x.patient_id.id == p.id)[0] or False"/>

                                    <tr>

                                        <td><t t-esc="p.name"/></td>
                                        <td><t t-esc="p.gender"/></td>
                                        <td><t t-esc="p.birth_date"/></td>
                                        <td><t t-esc="p.phone"/></td>

                                        <td t-att-style="
                                            v and v.status == 'planned' and 'background-color: yellow;' or
                                            v and v.status == 'done' and 'background-color: lightgreen;' or
                                            v and v.status == 'cancelled' and 'background-color: red;' or ''
                                        ">
                                            <t t-esc="v.status if v else ''"/>
                                        </td>

                                    </tr>

                                </t>

                            </tbody>

                        </table>

                        <!-- FOOTER -->
<!--                        <div style="position: fixed; bottom: 0; width: 100%; font-size: 12px; border-top: 1px solid #ccc;">-->

<!--                            <div class="row">-->

<!--                                <div class="col-6">-->
<!--                                    Дата друку:-->
<!--                                    <t t-esc="context_timestamp(doc, datetime.datetime.now()).strftime('%d.%m.%Y %H:%M')"/>-->
<!--                                </div>-->

<!--                                <div class="col-6 text-end">-->
<!--                                    Місто:-->
<!--                                    <t t-esc="doc.env.company.city or doc.env.company.partner_id.city"/>-->
<!--                                </div>-->

<!--                            </div>-->

<!--                        </div>-->

                    </div>

                </t>

            </t>
        </t>

    </template>


    <!-- REPORT ACTION -->
    <record id="action_report_doctor" model="ir.actions.report">

        <field name="name">Doctor Report</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="report_type">qweb-pdf</field>

        <field name="report_name">hr_hospital.report_doctor_document</field>
        <field name="report_file">hr_hospital.report_doctor_document</field>

        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_type">report</field>

    </record>

</odoo>